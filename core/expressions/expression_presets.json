  {"name": "Spiral", "description": "Spiral outward motion", "category": "Complex", "expression": "[comp.width/2+time*30*Math.cos(time*3),comp.height/2+time*30*Math.sin(time*3)]"},
  {"name": "Damped Wave", "description": "Damped sinusoidal wave", "category": "Complex", "expression": "50*Math.exp(-time*0.3)*Math.sin(time*5)"},
